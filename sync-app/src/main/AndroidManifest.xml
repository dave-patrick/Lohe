<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required on Android 11+ to query and bind to Lohe Play and Lohe FOSS providers. -->
    <queries>
        <package android:name="com.lohe.app" />
        <package android:name="com.lohe.app.foss" />
    </queries>

    <!-- Signature-protected owner-only permissions defined by Play and FOSS builds. -->
    <uses-permission android:name="com.lohe.app.permission.OWNER_SYNC" />
    <uses-permission android:name="com.lohe.app.foss.permission.OWNER_SYNC" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_sync_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_sync_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
