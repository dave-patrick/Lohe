<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      androidx.car.app:app-automotive declares minSdk 29 because the Android
      Automotive OS surface it provides only exists from API 29 on. Lohe keeps
      minSdk 26 for phones: the automotive classes are never loaded on a phone,
      so the library's floor is overridden rather than raised for the whole app.
    -->
    <uses-sdk tools:overrideLibrary="androidx.car.app.automotive" />

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Local folder playback goes through the Storage Access Framework, which
      grants per-tree access without a runtime permission. Broad media
      permissions are still listed for on-device discovery on API <= 32; on
      API 33+ READ_MEDIA_AUDIO covers the equivalent.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Playback continues while the app is backgrounded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android Automotive OS / templated media app. -->
    <uses-permission android:name="androidx.car.app.MEDIA_TEMPLATES" />
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <uses-feature
        android:name="android.software.car.templates_host.media"
        android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lohe"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Lohe"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Android Automotive OS car app service. -->
        <service
            android:name=".playback.CarPlaybackService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.MEDIA" />
            </intent-filter>
            <meta-data
                android:name="androidx.car.app.minCarApiLevel"
                android:value="8" />
        </service>

        <!--
          The head unit renders media browsing and playback through the
          MediaLibraryService above; CarPlaybackService adds the templated
          MediaPlaybackTemplate surface where the car host supports it.
        -->

        <!-- Android Auto (projection) declaration. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Automotive OS declaration. -->
        <meta-data
            android:name="com.android.automotive"
            android:resource="@xml/automotive_app_desc" />

    </application>

</manifest>
