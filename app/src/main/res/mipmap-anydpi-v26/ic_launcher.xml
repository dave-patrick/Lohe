<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon: the Lohe geometric dragonfly hero mark.

  The background layer carries the deep-navy tile and rim glow; the
  foreground layer carries the mark itself and is kept inside the
  66dp safe zone so no launcher mask clips the wings or tail.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>