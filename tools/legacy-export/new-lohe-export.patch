diff --git a/app/src/main/java/com/lohe/app/data/NewLoheExport.kt b/app/src/main/java/com/lohe/app/data/NewLoheExport.kt
new file mode 100644
index 0000000..565468c
--- /dev/null
+++ b/app/src/main/java/com/lohe/app/data/NewLoheExport.kt
@@ -0,0 +1,218 @@
+package com.lohe.app.data
+
+import com.lohe.app.LOHE_USER_AGENT
+import com.lohe.app.data.db.entity.EpisodeEntity
+import com.lohe.app.data.db.entity.PodcastEntity
+import com.lohe.app.data.fetch.FeedParser
+import com.lohe.app.network.readBoundedBytes
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import org.json.JSONArray
+import org.json.JSONObject
+import org.xmlpull.v1.XmlPullParser
+import org.xmlpull.v1.XmlPullParserFactory
+import java.io.StringReader
+import java.util.concurrent.TimeUnit
+
+/**
+ * One-time export of this library as a backup the new Lohe (Play Edition) imports
+ * through Settings > Import from another app > Lohe JSON backup.
+ *
+ * Episode and podcast ids are written in the new app's own scheme, so its later
+ * feed refreshes recognise imported episodes instead of adding duplicates:
+ *  - podcast: "pod_" + feedUrl.trim().lowercase().hashCode()
+ *  - episode: "ep_" + (guid.trim() or "$feedUrl#$title").hashCode()
+ *
+ * This app never stored publisher GUIDs (episode uuids are a hash of them), so
+ * each feed is downloaded once to recover the GUID of every exported episode.
+ * Feeds that fail to download fall back to the title-based id.
+ */
+object NewLoheExport {
+
+    data class Result(val json: String, val shows: Int, val episodes: Int, val playlists: Int, val feedsUnreachable: Int)
+
+    private const val MAX_FEED_BYTES = 16 * 1024 * 1024
+
+    private val client by lazy {
+        OkHttpClient.Builder()
+            .connectTimeout(20, TimeUnit.SECONDS)
+            .readTimeout(30, TimeUnit.SECONDS)
+            .callTimeout(60, TimeUnit.SECONDS)
+            .build()
+    }
+
+    suspend fun build(onProgress: (String) -> Unit = {}): Result = withContext(Dispatchers.IO) {
+        val db = ServiceLocator.database()
+        val podcasts = db.podcastDao().allOnce()
+        val allEpisodes = db.episodeDao().allOnce().filter { !it.isDeleted }
+        val playlists = ServiceLocator.playlistRepository().playlists.value
+
+        val playlistMembers = playlists.flatMap { it.episodeUuids }.toSet()
+        val exported = allEpisodes.filter { ep ->
+            ep.playingStatus != EpisodeEntity.UNPLAYED ||
+                ep.playedAt != null ||
+                ep.starred ||
+                ep.isArchived ||
+                ep.queuePosition != null ||
+                ep.uuid in playlistMembers
+        }
+        val podcastsByUuid = podcasts.associateBy { it.uuid }
+        val newPodcastId = podcasts.associate { it.uuid to newPodcastId(it.feedUrl) }
+
+        // Recover publisher GUIDs, one feed download per show that has exported episodes.
+        val guidByUuid = HashMap<String, String>()
+        var unreachable = 0
+        val showsNeedingGuids = exported.map { it.podcastUuid }.distinct()
+        showsNeedingGuids.forEachIndexed { index, podcastUuid ->
+            val podcast = podcastsByUuid[podcastUuid] ?: return@forEachIndexed
+            onProgress("Reading feeds ${index + 1} / ${showsNeedingGuids.size}: ${podcast.title}")
+            val guids = runCatching { downloadGuids(podcast.feedUrl) }.getOrNull()
+            if (guids == null) {
+                unreachable++
+                return@forEachIndexed
+            }
+            for ((oldRawGuid, newGuid) in guids) {
+                guidByUuid[FeedParser.stableUuid(podcastUuid, oldRawGuid)] = newGuid
+            }
+        }
+
+        onProgress("Writing backup")
+        val newEpisodeId = HashMap<String, String>()
+        val episodeArray = JSONArray()
+        val queueOrder = exported.filter { it.queuePosition != null }
+            .sortedBy { it.queuePosition }
+            .mapIndexed { i, ep -> ep.uuid to i }
+            .toMap()
+        for (ep in exported) {
+            val podcast = podcastsByUuid[ep.podcastUuid] ?: continue
+            val guid = guidByUuid[ep.uuid]?.trim().orEmpty()
+            val id = "ep_" + guid.ifBlank { "${podcast.feedUrl}#${ep.title.trim()}" }.hashCode()
+            newEpisodeId[ep.uuid] = id
+            val durationMs = (ep.durationSeconds ?: 0).toLong() * 1000L
+            episodeArray.put(
+                JSONObject()
+                    .put("id", id)
+                    .put("podcastId", newPodcastId.getValue(podcast.uuid))
+                    .put("podcastTitle", podcast.title)
+                    .put("title", ep.title)
+                    .put("description", ep.description ?: "")
+                    .put("audioUrl", ep.audioUrl)
+                    .put("artworkUrl", ep.artworkUrl ?: podcast.artworkUrl ?: "")
+                    .put("publishedAt", ep.published * 1000L)
+                    .apply { if (durationMs > 0) put("durationMs", durationMs) }
+                    .put(
+                        "resumePositionMs",
+                        if (ep.playingStatus == EpisodeEntity.PLAYED) 0L else ep.playedUpToSeconds * 1000L,
+                    )
+                    .put("isPlayed", ep.playingStatus == EpisodeEntity.PLAYED)
+                    .put("playedAt", ep.playedAt ?: 0L)
+                    .put("isArchived", ep.isArchived)
+                    .put("isStarred", ep.starred)
+                    .put("inUpNext", ep.queuePosition != null)
+                    .put("upNextOrder", queueOrder[ep.uuid] ?: 0)
+                    .put("guid", guid),
+            )
+        }
+
+        val podcastArray = JSONArray()
+        for (podcast in podcasts) {
+            podcastArray.put(
+                JSONObject()
+                    .put("id", newPodcastId.getValue(podcast.uuid))
+                    .put("title", podcast.title)
+                    .put("author", podcast.author ?: "")
+                    .put("description", podcast.description ?: "")
+                    .put("feedUrl", podcast.feedUrl)
+                    .put("artworkUrl", podcast.artworkUrl ?: "")
+                    .put("isSubscribed", true)
+                    .put(
+                        "autoQueueMode",
+                        when {
+                            !podcast.autoAddNewEpisodesToUpNext -> "OFF"
+                            podcast.autoAddNewEpisodesAtTop -> "BEGINNING"
+                            else -> "END"
+                        },
+                    ),
+            )
+        }
+
+        val playlistArray = JSONArray()
+        for (playlist in playlists) {
+            playlistArray.put(
+                JSONObject()
+                    .put("id", "pl_legacy_${playlist.id}")
+                    .put("name", playlist.name)
+                    .put("folderName", playlist.folder.ifBlank { "General" })
+                    .put("episodeIdsCsv", playlist.episodeUuids.mapNotNull { newEpisodeId[it] }.joinToString(","))
+                    .put(
+                        "assignedPodcastIdsCsv",
+                        (playlist.assignedPodcastUuids + playlist.shows).distinct()
+                            .mapNotNull { newPodcastId[it] }.joinToString(","),
+                    )
+                    .put("isPinned", playlist.pinned)
+                    .put("autoDownload", playlist.autoDownload)
+                    .put("createdAt", playlist.createdAt),
+            )
+        }
+
+        val root = JSONObject()
+            .put("format", "lohe-legacy-export")
+            .put("version", 1)
+            .put("exportedAt", System.currentTimeMillis())
+            .put("podcasts", podcastArray)
+            .put("episodes", episodeArray)
+            .put("playlists", playlistArray)
+        Result(root.toString(2), podcasts.size, episodeArray.length(), playlistArray.length(), unreachable)
+    }
+
+    fun newPodcastId(feedUrl: String): String = "pod_" + feedUrl.trim().lowercase().hashCode()
+
+    /**
+     * For every item in [feedUrl] that has an id: the raw id as this app's FeedParser
+     * read it (first guid/id tag, namespace prefix ignored, untrimmed) paired with the
+     * id the new Lohe reads (last unprefixed guid/id tag, trimmed).
+     */
+    private fun downloadGuids(feedUrl: String): List<Pair<String, String>> {
+        val request = Request.Builder().url(feedUrl).header("User-Agent", LOHE_USER_AGENT).build()
+        val text = client.newCall(request).execute().use { response ->
+            check(response.isSuccessful) { "HTTP ${response.code}" }
+            val body = response.body ?: error("empty body")
+            String(body.readBoundedBytes(MAX_FEED_BYTES), Charsets.UTF_8)
+        }
+        val start = text.indexOf('<').coerceAtLeast(0)
+        val parser = XmlPullParserFactory.newInstance().newPullParser().apply {
+            setFeature(XmlPullParser.FEATURE_PROCESS_NAMESPACES, false)
+            setInput(StringReader(text.substring(start)))
+        }
+        val guids = mutableListOf<Pair<String, String>>()
+        var inItem = false
+        var oldGuid: String? = null
+        var newGuid = ""
+        var event = parser.eventType
+        while (event != XmlPullParser.END_DOCUMENT) {
+            when (event) {
+                // Same tag matching as FeedParser: namespace prefixes are ignored.
+                XmlPullParser.START_TAG -> when (parser.name?.substringAfterLast(':').orEmpty()) {
+                    "item", "entry" -> { inItem = true; oldGuid = null; newGuid = "" }
+                    "guid", "id" -> if (inItem) {
+                        val unprefixed = parser.name == "guid" || parser.name == "id" ||
+                            parser.name.equals("guid", ignoreCase = true) || parser.name.equals("id", ignoreCase = true)
+                        val text = runCatching { parser.nextText() }.getOrNull()
+                        if (text != null) {
+                            if (oldGuid == null) oldGuid = text
+                            if (unprefixed) newGuid = text.trim()
+                        }
+                    }
+                }
+                XmlPullParser.END_TAG -> if (parser.name == "item" || parser.name == "entry") {
+                    inItem = false
+                    oldGuid?.let { guids.add(it to newGuid) }
+                }
+            }
+            event = parser.next()
+        }
+        return guids
+    }
+}
